<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Deep haunted near-black backgrounds -->
    <Color x:Key="ApplicationBackgroundColor">#FF0A0B0D</Color>
    <Color x:Key="SolidBackgroundFillColorBase">#FF0A0B0D</Color>
    <Color x:Key="SolidBackgroundFillColorSecondary">#FF111318</Color>
    <Color x:Key="SolidBackgroundFillColorTertiary">#FF16181D</Color>
    <Color x:Key="SolidBackgroundFillColorQuarternary">#FF1C1F25</Color>

    <!-- Blood-crimson controls with subtle ghostly transparency -->
    <Color x:Key="ControlFillColorDefault">#1A8B0000</Color>
    <Color x:Key="ControlFillColorSecondary">#268B0000</Color>
    <Color x:Key="ControlFillColorTertiary">#108B0000</Color>
    <Color x:Key="CardBackgroundFillColorDefault">#1A8B0000</Color>
    <Color x:Key="CardBackgroundFillColorSecondary">#108B0000</Color>

    <!-- Pale and ghostly text -->
    <Color x:Key="TextFillColorPrimary">#FFE8E0D8</Color>
    <Color x:Key="TextFillColorSecondary">#C5E8E0D8</Color>
    <Color x:Key="TextFillColorTertiary">#87E8E0D8</Color>

    <!-- Decayed border strokes -->
    <Color x:Key="ControlStrokeColorDefault">#30E8E0D8</Color>
    <Color x:Key="ControlStrokeColorSecondary">#45E8E0D8</Color>
    <Color x:Key="ControlStrokeColorTertiary">#A5E8E0D8</Color>

    <!-- Brushes for the colors above -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF0A0B0D" />
    <SolidColorBrush x:Key="ApplicationBackgroundColorBrush" Color="#FF0A0B0D" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF0A0B0D" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF111318" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF16181D" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FF1C1F25" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1A8B0000" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#268B0000" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#108B0000" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1A8B0000" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#108B0000" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE8E0D8" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5E8E0D8" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87E8E0D8" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#30E8E0D8" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#45E8E0D8" />
    <SolidColorBrush x:Key="ControlStrokeColorTertiaryBrush" Color="#A5E8E0D8" />

    <!-- Bloxstrap-style blue accent -->
    <Color x:Key="SystemAccentColor">#FF3A9CEA</Color>
    <Color x:Key="SystemAccentColorSecondary">#FF1E88E5</Color>
    <Color x:Key="SystemAccentColorTertiary">#FF1565C0</Color>

    <!-- Brushes for status indicators -->
    <SolidColorBrush x:Key="PaletteGreenBrush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="PaletteRedBrush" Color="#FFEF4444" />
</ResourceDictionary>
