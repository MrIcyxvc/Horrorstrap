<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.ColorPickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:resources="clr-namespace:Bloxstrap.Resources"
             Background="{DynamicResource ApplicationBackground}"
             mc:Ignorable="d"
             Title="Pick a color"
             MinWidth="340"
             Width="340"
             MinHeight="420"
             Height="420"
             ResizeMode="NoResize"
             WindowStartupLocation="CenterScreen"
             ExtendsContentIntoTitleBar="True"
             d:DesignHeight="420" d:DesignWidth="340">
    <Grid Margin="12" Background="{DynamicResource ApplicationBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <colorpicker:StandardColorPicker x:Name="Picker" Grid.Row="0" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="OK" Appearance="Primary" Click="OkButton_Click" />
            <ui:Button Content="Cancel" Margin="8,0,0,0" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</base:WpfUiWindow>


